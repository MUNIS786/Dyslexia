# ==========================================
# DyslexAid .gitignore
# ==========================================

# Environment variables & secrets
.env
.env.*
*.env
!.env.example

# Node dependencies & builds
node_modules/
*/node_modules/
dist/
*/dist/
build/
*/build/
.dist/

# Python bytecode & cache
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyo

# Python virtual environments
.venv/
*/.venv/
venv/
*/venv/
dyslexaid-venv/
*/dyslexaid-venv/
env/
*/env/
ENV/

# Testing & quality assurance caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
coverage/
htmlcov/
.coverage

# IDE & Editor metadata
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs & runtimes
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary uploads & OCR files
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
*.tmp
*.temp

# Temporary helper wrappers & backup archives
powershell.cmd
*/powershell.cmd
*.zip
*.tar.gz
change/
