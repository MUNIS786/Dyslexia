# DyslexAid Backend — Environment Variables Template
# Copy this file to .env and configure your values

# MongoDB (required)
MONGO_URL=mongodb://localhost:27017
DB_NAME=dyslexaid

# JWT Secret (change this in production!)
JWT_SECRET=your_jwt_secret_here

# AI Keys — at least one is needed for AI features
# Without these, app falls back to offline rule-based processing
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMERGENT_LLM_KEY=

# Optional AI Configuration
GEMINI_MODEL=gemini-2.0-flash
CHAT_OFFLINE_MODE=false
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=*

# Server
PORT=8000
