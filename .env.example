# ==============================================================================
# DyslexAid V2 — Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env in your backend environment:
#   cp .env.example backend/.env
#
# SECURITY NOTICE:
# - NEVER commit .env, private keys, or credentials to version control.
# - In production (ENV=production), JWT_SECRET must be at least 16 random characters.
# - In production, CORS_ORIGINS must list explicit domains; wildcard '*' is rejected
#   when credentials/cookies are enabled.
# ==============================================================================

# --- Application Environment ---
ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Database (MongoDB) ---
# For local development: mongodb://localhost:27017
# For replica set / cloud: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=dyslexaid
DB_SERVER_SELECTION_TIMEOUT_MS=3000
DB_CONNECT_TIMEOUT_MS=3000

# --- Authentication & JWT Security ---
# Generate a strong key for production (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_16_chars
JWT_ALG=HS256
JWT_EXP_DAYS=30

# --- Email Provider & Password Recovery ---
# Providers: console (dev/test fallback, logs links to server log), smtp (production)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@dyslexaid.org
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FRONTEND_URL=http://localhost:5173
# Set to true to require email verification before allowing signin
REQUIRE_EMAIL_VERIFICATION=false

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of allowed origins. Do NOT use '*' in production.
# Development default: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- External AI Model Keys (Optional — Fallback mock available) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=
CHAT_OFFLINE_MODE=false

# --- V2 Subsystem Feature Flags (true / false) ---
V2_ENABLED=true
V2_LEARNER_PROFILE=true
V2_ADAPTIVE_ENGINE=true
V2_READING_COACH=true
V2_SPEECH_ANALYSIS=true
V2_AI_TUTOR=true
V2_TEACHER_ANALYTICS=true
V2_INTERVENTION_EFFECTIVENESS=true
V2_GAMIFICATION=true
V2_MULTILINGUAL=true
V2_PARENT_PORTAL=true
V2_ACCESSIBILITY_PREFERENCES=true
V2_LEARNING_INSIGHTS=true
V2_LEARNING_RECOMMENDATIONS=true
V2_PERSONALIZED_CONTENT=true
V2_CONTENT_AUTHORING=true

# --- Frontend Build Configuration (frontend/.env) ---
# In development: leave unset or use /api (Vite dev proxy forwards to backend)
# In production: https://your-backend-domain.com/api
VITE_API_BASE=/api
