# ==========================================
# DyslexAid Configuration Template (.env.example)
# ==========================================
# Copy this file to .env in your backend or configure individually.
# Never commit actual production secrets to source control.

# --- Backend Configuration ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=dyslexaid
JWT_SECRET=your_jwt_secret_here

# AI Service Keys (at least one enabled for full AI features)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=

# Server Configuration
PORT=8000
CORS_ORIGINS=*
GEMINI_MODEL=gemini-2.0-flash
CHAT_OFFLINE_MODE=false
LOG_LEVEL=INFO

# --- Frontend Configuration ---
VITE_API_BASE=http://localhost:8000/api
